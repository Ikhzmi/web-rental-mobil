// KerenTal Kita — Prisma schema
// Mengikuti §9 PRD v1.1.
//
// CATATAN PENTING (lihat §8 PRD): `profiles.id` secara logis sama dengan
// `auth.users.id` milik Supabase Auth, tapi TIDAK dideklarasikan sebagai
// hard foreign key di sini. Prisma tidak mendukung FK constraint lintas
// schema Postgres (public -> auth) — https://github.com/prisma/prisma/issues/16585.
// Konsistensi id dijamin oleh trigger `on_auth_user_created`
// (lihat prisma/sql/001_on_auth_user_created_trigger.sql), bukan oleh
// constraint database. Perlakukan sebagai soft reference.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // CATATAN PRISMA 7: url & directUrl TIDAK BOLEH lagi ditaruh di sini
  // sejak Prisma 7 (breaking change per Nov 2025) — sekarang wajib
  // pindah ke prisma.config.ts (untuk CLI/migration) dan ke driver
  // adapter di src/lib/prisma.ts (untuk runtime). Lihat kedua file itu.
}

// ──────────────────────────────────────────────────────────────────────────────
// ENUMS v1.3
// ──────────────────────────────────────────────────────────────────────────────

/// Peran pengguna: customer (penyewa), admin (admin instansi), super_admin (platform)
enum Role {
  customer
  admin
  super_admin

  @@map("role")
}

/// Kategori mobil - diperluas dari 4 ke 8 di v1.3
enum KategoriMobil {
  city_car
  hatchback  // BARU v1.3
  suv
  mpv
  minibus    // BARU v1.3
  pickup     // BARU v1.3
  mewah
  electric   // BARU v1.3 - Electric Vehicle

  @@map("kategori_mobil")
}

enum Transmisi {
  manual
  matic

  @@map("transmisi")
}

enum BahanBakar {
  bensin
  diesel
  hybrid
  electric

  @@map("bahan_bakar")
}

enum TipeSewa {
  lepas_kunci
  dengan_sopir
  keduanya

  @@map("tipe_sewa")
}

/// Status operasional mobil
enum StatusMobil {
  tersedia
  maintenance
  nonaktif

  @@map("status_mobil")
}

/// Status approval mobil oleh Super Admin - BARU v1.3
enum StatusApproval {
  menunggu_persetujuan  // Mobil baru, belum disetujui Super Admin
  disetujui             // Sudah disetujui, bisa tayang di katalog
  ditolak               // Ditolak dengan alasan

  @@map("status_approval")
}

/// Status instansi rental - BARU v1.3
enum StatusInstansi {
  menunggu_verifikasi  // Baru daftar, menunggu verifikasi Super Admin
  aktif               // Sudah diverifikasi, aktif
  nonaktif             // Dinonaktifkan
  ditolak              // Ditolak oleh Super Admin

  @@map("instansi_status")
}

/// Status booking dengan payment gateway - updated v2
/// 'pending' diubah menjadi 'menunggu_pembayaran' karena payment via payment gateway
enum StatusBooking {
  menunggu_pembayaran  // Baru dibuat, menunggu pembayaran
  dikonfirmasi         // Pembayaran berhasil
  berjalan             // Sedang disewa
  selesai              // Sewa selesai
  dibatalkan           // Dibatalkan (dari menunggu_pembayaran)

  @@map("status_booking")
}

/// Metode pembayaran - v2
enum MetodeBayar {
  virtual_account
  qris
  ewallet
  kartu_kredit

  @@map("metode_bayar")
}

/// Status payment - v2
enum StatusPayment {
  pending   // Invoice dibuat, belum dibayar
  paid      // Pembayaran berhasil
  expired   // Invoice kedaluwarsa
  failed    // Pembayaran gagal

  @@map("status_payment")
}

/// Status disbursement ke instansi - v2
enum StatusDisbursement {
  diproses   // Sedang diproses
  berhasil    // Dana berhasil ditransfer
  gagal       // Transfer gagal

  @@map("status_disbursement")
}

/// Status refund pengembalian dana - v2
enum StatusRefund {
  menunggu_persetujuan  // Menunggu disetujui admin instansi
  disetujui             // Disetujui admin, siap diproses transfer
  diproses              // Sedang dalam antrean transfer
  berhasil              // Dana telah ditransfer ke rekening pelanggan
  ditolak               // Permintaan refund ditolak

  @@map("status_refund")
}


enum JenisAddon {
  sopir
  asuransi
  antar_jemput

  @@map("jenis_addon")
}

/// Memperluas auth.users bawaan Supabase — 1:1, id sama persis dengan
/// auth.users.id (soft reference, lihat catatan di atas berkas ini).
/// Updated v1.3:
/// - noKtp dan noSim dihapus (verifikasi cukup via dokumen upload)
/// - instansiId ditambahkan (FK ke instansi untuk role admin)
model Profile {
  id              String   @id @db.Uuid
  nama            String
  email           String   @unique
  noHp            String   @map("no_hp")
  role            Role     @default(customer)
  alamat          String?  @map("alamat")
  noKtp           String?  @map("no_ktp")
  noSim           String?  @map("no_sim")
  dokumenKtpUrl   String?  @map("dokumen_ktp_url")
  dokumenSimUrl   String?  @map("dokumen_sim_url")
  aktif           Boolean  @default(true)
  lastSeenAt      DateTime? @map("last_seen_at")
  namaBank            String?  @map("nama_bank")
  nomorRekening       String?  @map("nomor_rekening")
  namaPemilikRekening String?  @map("nama_pemilik_rekening")
  dokumenVerified Boolean  @default(false) @map("dokumen_verified")
  createdAt       DateTime @default(now()) @map("created_at")

  /// BARU v1.3: Relasi ke instansi untuk admin
  /// Admin terikat ke satu instansi; customer dan super_admin null
  instansiId      String?  @map("instansi_id") @db.Uuid
  instansi       Instansi? @relation(fields: [instansiId], references: [id])

  bookings          Booking[]
  statusLogsDiubah  BookingStatusLog[] @relation("StatusLogDiubahOleh")
  reviews           Review[]
  conversationsAsCustomer Conversation[] @relation("CustomerConversations")
  chatMessagesSent  ChatMessage[]      @relation("SentChatMessages")
  notifications     Notification[]

  @@map("profiles")
}

/// Model mobil/armada rental.
/// Updated v1.3:
/// - instansiId ditambahkan (FK ke instansi)
/// - statusApproval ditambahkan (approval oleh Super Admin)
model Car {
  id                 String        @id @default(uuid()) @db.Uuid
  nama               String
  nomorPlat          String?       @map("nomor_plat") // Nomor polisi kendaraan, e.g. "BK 1234 XYZ"
  kategori           KategoriMobil
  transmisi          Transmisi
  bahanBakar         BahanBakar    @default(bensin) @map("bahan_bakar")
  tipeSewa           TipeSewa      @map("tipe_sewa")
  hargaSopirPerHari  Decimal?      @map("harga_sopir_per_hari") @db.Decimal(12, 2)
  hargaAntarJemput   Decimal?      @map("harga_antar_jemput") @db.Decimal(12, 2)
  kapasitasKursi     Int           @map("kapasitas_kursi")
  hargaPerHari       Decimal       @map("harga_per_hari") @db.Decimal(12, 2)
  status             StatusMobil   @default(tersedia)
  deskripsi          String?
  createdAt          DateTime      @default(now()) @map("created_at")

  /// BARU v1.3: Relasi ke instansi
  /// Setiap mobil milik satu instansi rental
  instansiId          String        @map("instansi_id") @db.Uuid
  instansi           Instansi      @relation(fields: [instansiId], references: [id])

  /// BARU v1.3: Status approval oleh Super Admin
  /// Mobil tidak bisa tayang di katalog sebelum disetujui
  statusApproval     StatusApproval @default(menunggu_persetujuan) @map("status_approval")
  alasanPenolakan     String?        @map("alasan_penolakan")

  images        CarImage[]
  bookings      Booking[]
  reviews       Review[]
  blockedDates  CarBlockedDate[]
  conversations Conversation[]
  chatMessages  ChatMessage[]

  @@map("cars")
}

model CarImage {
  id     String @id @default(uuid()) @db.Uuid
  carId  String @map("car_id") @db.Uuid
  url    String
  urutan Int    @default(0)

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@map("car_images")
  @@index([carId])
}

model CarBlockedDate {
  id             String   @id @default(uuid()) @db.Uuid
  carId          String   @map("car_id") @db.Uuid
  tanggalMulai   DateTime @map("tanggal_mulai") @db.Date
  tanggalSelesai DateTime @map("tanggal_selesai") @db.Date
  alasan         String?  @map("alasan")
  createdAt      DateTime @default(now()) @map("created_at")

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@map("car_blocked_dates")
  @@index([carId])
}

/// Model booking/pemesanan sewa mobil.
/// Updated v2:
/// - Status default adalah 'menunggu_pembayaran'
/// - Relasi ke Payment
/// - Relasi ke DisbursementItem (untuk tracking pencairan)
model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  carId          String        @map("car_id") @db.Uuid
  /// Timestamp penuh 01.00–23.00 WIB (bukan DATE): jam dipakai untuk
  /// jendela overlap, display dashboard, dan harga. Lihat 008.
  tanggalMulai   DateTime      @map("tanggal_mulai")
  tanggalSelesai DateTime      @map("tanggal_selesai")
  lokasiAmbil    String        @map("lokasi_ambil")
  lokasiKembali  String        @map("lokasi_kembali")
  hargaDasar     Decimal       @map("harga_dasar") @db.Decimal(12, 2)
  totalAddon     Decimal       @default(0) @map("total_addon") @db.Decimal(12, 2)
  totalHarga     Decimal       @map("total_harga") @db.Decimal(12, 2)
  /// Snapshot % komisi platform yang berlaku SAAT booking dibuat.
  /// Agregat historis (dashboard, laporan, disbursement) WAJIB memakai ini,
  /// bukan rate live instansi — supaya perubahan rate tidak mengubah masa
  /// lalu secara retroaktif. Diisi backend saat create; backfill untuk data
  /// lama di prisma/sql/007_komisi_snapshot.sql.
  komisiPersenSnapshot Decimal? @map("komisi_persen_snapshot") @db.Decimal(5, 2)
  /// Default 'menunggu_pembayaran' karena menunggu konfirmasi dari payment gateway
  status         StatusBooking @default(menunggu_pembayaran)
  alasanPembatalan String?       @map("alasan_pembatalan")
  rekeningRefund   String?       @map("rekening_refund")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  profile    Profile            @relation(fields: [userId], references: [id])
  car        Car                @relation(fields: [carId], references: [id])
  addons     BookingAddon[]
  statusLogs BookingStatusLog[]

  /// v2: Relasi ke Payment
  payment    Payment?
  disbursementItems DisbursementItem[]
  /// Ulasan customer untuk booking ini — hanya bisa dibuat setelah status
  /// 'selesai', satu ulasan per booking (lihat model Review).
  review     Review?
  refund     Refund?

  @@map("bookings")
  @@index([carId, tanggalMulai, tanggalSelesai])
  @@index([userId])
}

model BookingAddon {
  id        String     @id @default(uuid()) @db.Uuid
  bookingId String     @map("booking_id") @db.Uuid
  jenis     JenisAddon
  harga     Decimal    @db.Decimal(12, 2)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_addons")
  @@index([bookingId])
}

/// Audit trail perubahan status booking.
model BookingStatusLog {
  id          String   @id @default(uuid()) @db.Uuid
  bookingId   String   @map("booking_id") @db.Uuid
  statusLama  String   @map("status_lama")
  statusBaru  String   @map("status_baru")
  diubahOleh  String   @map("diubah_oleh") @db.Uuid
  catatan     String?  @map("catatan")
  createdAt   DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  admin   Profile @relation("StatusLogDiubahOleh", fields: [diubahOleh], references: [id])

  @@map("booking_status_log")
  @@index([bookingId])
}

/// Ulasan customer untuk mobil, ditulis setelah masa sewa selesai.
/// Keputusan produk (bukan bug, disengaja):
///   - Hanya bisa dibuat kalau booking.status = 'selesai' (dicek di backend,
///     bukan di skema — lihat reviews.routes.ts)
///   - Satu ulasan per booking (bookingId unik), bukan dibatasi per car+user,
///     supaya rental yang sama tidak bisa dinilai berkali-kali
///   - Langsung tayang publik, TANPA moderasi admin
///   - TIDAK ADA endpoint hapus, bahkan untuk admin — ulasan permanen
///     begitu dibuat customer
model Review {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @unique @map("booking_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  carId     String   @map("car_id") @db.Uuid
  rating    Int      // 1-5, divalidasi di backend
  komentar  String?
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [userId], references: [id])
  car     Car     @relation(fields: [carId], references: [id])

  @@map("reviews")
  @@index([carId, createdAt(sort: Desc)])
}

// ──────────────────────────────────────────────────────────────────────────────
// MODELS BARU v1.3 - Marketplace Multi-Instansi
// ──────────────────────────────────────────────────────────────────────────────

/// Model instansi rental yang terdaftar di platform.
/// Setiap instansi punya admin sendiri dan mengelola armadanya.
/// Super Admin memverifikasi instansi sebelum bisa aktif.
model Instansi {
  id                    String         @id @default(uuid()) @db.Uuid
  namaInstansi          String         @map("nama_instansi")
  alamat                String
  noHpPic               String         @map("no_hp_pic")
  emailPic              String         @map("email_pic")
  dokumenLegalitasUrl   String?        @map("dokumen_legalitas_url")
  status                StatusInstansi @default(menunggu_verifikasi) @map("status")
  /// Persentase komisi platform dari total harga sewa
  /// Default 10%, bisa berbeda per instansi yang disepakati
  komisiPlatformPersen  Decimal        @default(10) @map("komisi_platform_persen") @db.Decimal(5, 2)
  /// Format: "BANK_CODE-ACCOUNT_NUMBER" (contoh: "BCA-1234567890")
  /// Untuk pencairan dana ke rekening instansi
  rekeningBank          String?        @map("rekening_bank")
  npwp                  String?        @map("npwp")
  createdAt             DateTime       @default(now()) @map("created_at")

  /// Relasi
  profiles       Profile[]
  cars          Car[]
  disbursements Disbursement[]
  conversations Conversation[]
  notifications Notification[]

  @@map("instansi")
}

/// Model payment untuk mencatat transaksi.
/// Setiap booking memiliki satu payment record.
model Payment {
  id               String         @id @default(uuid()) @db.Uuid
  bookingId        String         @unique @map("booking_id") @db.Uuid
  /// ID invoice dari payment gateway
  gatewayInvoiceId String?        @map("gateway_invoice_id")
  /// ID order dari payment gateway - uniqueness untuk idempotency
  gatewayOrderId   String?        @unique @map("gateway_order_id")
  /// Kode pembayaran (untuk VA/cstore)
  gatewayPaymentCode String?       @map("gateway_payment_code")
  metodeBayar      MetodeBayar    @map("metode_bayar")
  jumlah           Decimal        @db.Decimal(12, 2)
  status           StatusPayment  @default(pending)
  paidAt           DateTime?      @map("paid_at")

  booking Booking @relation(fields: [bookingId], references: [id])
  webhookLogs WebhookLog[]

  @@map("payments")
}

/// Model untuk mencatat webhook yang sudah diproses (idempotency)
/// Mencegah replay attack dengan menyimpan transaction ID yang sudah diproses
model WebhookLog {
  id             String   @id @default(uuid()) @db.Uuid
  paymentId     String   @map("payment_id") @db.Uuid
  transactionId String   @map("transaction_id")
  eventType     String   @map("event_type")
  /// Hash dari request body untuk audit trail
  requestHash   String?  @map("request_hash")
  processedAt   DateTime @default(now()) @map("processed_at")

  payment Payment @relation(fields: [paymentId], references: [id])

  @@unique([transactionId, eventType])
  @@index([paymentId])
  @@map("webhook_logs")
}

/// Model disbursement untuk mencatat pencairan dana ke instansi.
/// Dana dicairkan dalam batch mingguan (setiap Senin).
model Disbursement {
  id                     String             @id @default(uuid()) @db.Uuid
  instansiId             String             @map("instansi_id") @db.Uuid
  /// Total harga dari semua booking dalam batch ini
  jumlahKotor            Decimal            @map("jumlah_kotor") @db.Decimal(12, 2)
  /// Komisi platform yang dipotong
  komisiPlatform         Decimal            @map("komisi_platform") @db.Decimal(12, 2)
  /// Jumlah bersih yang ditransfer ke rekening instansi
  jumlahBersih           Decimal            @map("jumlah_bersih") @db.Decimal(12, 2)
  status                 StatusDisbursement @default(diproses)
  /// ID referensi transfer bank untuk tracking manual
  bankTransferId         String?           @map("bank_transfer_id")
  /// Timestamp saat dana berhasil dicairkan
  dicairkanPada          DateTime?         @map("dicairkan_pada")
  createdAt              DateTime          @default(now()) @map("created_at")

  instansi Instansi           @relation(fields: [instansiId], references: [id])
  items     DisbursementItem[]

  @@map("disbursements")
}

/// Junction table untuk menghubungkan disbursement dengan booking.
/// Satu disbursement bisa mencakup banyak booking (batch).
model DisbursementItem {
  id             String    @id @default(uuid()) @db.Uuid
  disbursementId String    @map("disbursement_id") @db.Uuid
  bookingId      String    @map("booking_id") @db.Uuid
  /// Kontribusi harga booking ini ke total disbursement
  jumlahKotor   Decimal   @map("jumlah_kotor") @db.Decimal(12, 2)
  /// Snapshot % komisi saat batch dibuat (audit trail; batch header sudah
  /// menyimpan angka final komisiPlatform/jumlahBersih).
  komisiPersenSnapshot Decimal? @map("komisi_persen_snapshot") @db.Decimal(5, 2)

  disbursement Disbursement @relation(fields: [disbursementId], references: [id])
  booking     Booking     @relation(fields: [bookingId], references: [id])

  @@map("disbursement_items")
}

// ──────────────────────────────────────────────────────────────────────────────
// DASHBOARD ANALYTICS MODELS (v1.3 Enhancement)
// ──────────────────────────────────────────────────────────────────────────────

/// Notifikasi sistem multi-role (Customer, Admin Instansi, Super Admin)
model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  instansiId  String?   @map("instansi_id") @db.Uuid
  targetRole  Role?     @map("target_role")
  type        String    // 'booking', 'payment', 'approval', 'disbursement', 'review', 'system', 'chat'
  title       String
  message     String
  data        Json?     // extra metadata (e.g. { actionUrl, bookingId, carId })
  isRead      Boolean   @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user        Profile?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  instansi    Instansi? @relation(fields: [instansiId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([instansiId, isRead, createdAt(sort: Desc)])
  @@index([targetRole, isRead, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([isRead])
}

/// Log aktivitas untuk timeline di dashboard Super Admin
model DashboardActivity {
  id          String    @id @default(uuid()) @db.Uuid
  type        String    // 'booking_confirmed', 'payment_received', 'instansi_registered', 'vehicle_approved', 'customer_registered', 'refund_processed'
  title       String
  description String?
  metadata    Json?     // extra data
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("dashboard_activities")
  @@index([createdAt(sort: Desc)])
  @@index([type])
}

// ──────────────────────────────────────────────────────────────────────────────
// CHAT & MESSAGING MODELS
// ──────────────────────────────────────────────────────────────────────────────

/// Model percakapan antara customer dan instansi rental mobil
model Conversation {
  id                  String   @id @default(uuid()) @db.Uuid
  customerId          String   @map("customer_id") @db.Uuid
  instansiId          String   @map("instansi_id") @db.Uuid
  /// Mobil yang sedang ditanyakan saat inisiasi chat (opsional)
  carId               String?  @map("car_id") @db.Uuid
  lastMessageAt       DateTime @default(now()) @map("last_message_at")
  lastMessageText     String?  @map("last_message_text")
  unreadCustomerCount Int      @default(0) @map("unread_customer_count")
  unreadAdminCount    Int      @default(0) @map("unread_admin_count")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  customer Profile     @relation("CustomerConversations", fields: [customerId], references: [id], onDelete: Cascade)
  instansi Instansi    @relation(fields: [instansiId], references: [id], onDelete: Cascade)
  car      Car?        @relation(fields: [carId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@unique([customerId, instansiId])
  @@index([customerId])
  @@index([instansiId])
  @@index([lastMessageAt(sort: Desc)])
  @@map("conversations")
}

/// Model pesan dalam obrolan
model ChatMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  senderRole     Role     @map("sender_role")
  pesan          String
  /// Lampiran kartu armada mobil yang ditanyakan (opsional)
  carId          String?  @map("car_id") @db.Uuid
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Profile      @relation("SentChatMessages", fields: [senderId], references: [id], onDelete: Cascade)
  car          Car?         @relation(fields: [carId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

// ──────────────────────────────────────────────────────────────────────────────
// REFUND MODEL
// ──────────────────────────────────────────────────────────────────────────────

/// Model refund pengembalian dana pembatalan pesanan
model Refund {
  id              String       @id @default(uuid()) @db.Uuid
  bookingId       String       @unique @map("booking_id") @db.Uuid
  paymentId       String?      @map("payment_id") @db.Uuid
  jumlahAsli      Decimal      @map("jumlah_asli") @db.Decimal(12, 2)     // Total harga sewa yang dibayar
  potonganAdmin   Decimal      @default(0) @map("potongan_admin") @db.Decimal(12, 2)  // 0% (tidak dibebankan ke user)
  jumlahRefund    Decimal      @map("jumlah_refund") @db.Decimal(12, 2)   // 100% dari dana dibayar
  rekeningTujuan  String?      @map("rekening_tujuan")                     // Format: "BANK-NOMOR_REKENING a.n. NAMA"
  alasan          String?
  status          StatusRefund @default(menunggu_persetujuan)
  disetujuiOleh   String?      @map("disetujui_oleh") @db.Uuid
  disetujuiPada   DateTime?    @map("disetujui_pada")
  diprosesOleh    String?      @map("diproses_oleh") @db.Uuid
  selesaiPada     DateTime?    @map("selesai_pada")
  catatan         String?                                                   // Catatan admin jika disetujui / ditolak
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("refunds")
  @@index([status])
}