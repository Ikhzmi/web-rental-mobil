# 
# STEP 1: Dapatkan API Key & Project Slug dari dashboard Pakasir.
# STEP 2: Webhook URL: http://localhost:3001/api/webhooks/pakasir (lokal/ngrok)
# ═══════════════════════════════════════════════════════════════════════════════

PAKASIR_API_KEY="oJkKcapCvqxSa7lvTCXy8sm2xJum8bmt"
PAKASIR_PROJECT_SLUG="kerental-kita"


