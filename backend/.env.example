# ── Prisma / Postgres (dari dashboard Supabase: Project Settings > Database) ──
# Connection pooler (PgBouncer, port 6543) — dipakai runtime app.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Koneksi langsung (port 5432) — khusus `prisma migrate`.
DIRECT_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:5432/postgres"

# ── Supabase (dari dashboard: Project Settings > API) ──
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# Anon key — aman dipakai untuk memverifikasi token di middleware.
SUPABASE_ANON_KEY="eyJ..."
# Service-role key — RAHASIA. Jangan pernah commit ke repo atau kirim ke frontend.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ── App ──
PORT=3001
# Origin frontend yang diizinkan CORS, pisahkan dengan koma bila lebih dari satu.
FRONTEND_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# ═══════════════════════════════════════════════════════════════════════════════
# BAYAR.GG PAYMENT GATEWAY
# ═══════════════════════════════════════════════════════════════════════════════
# Register di: https://www.bayar.gg
# Docs: https://www.bayar.gg/api-docs
#
# STEP 1: Register di bayar.gg
#   - Buka https://www.bayar.gg dan daftar akun
#   - Verifikasi akun Anda
#   - Buka Dashboard -> Settings -> API Key
#   - Salin API Key
#
# STEP 2: Configure Webhook (untuk menerima callback)
#   - Buka Dashboard -> Settings -> Webhooks
#   - Set URL callback: https://your-domain.com/api/webhooks/bayargg
#   - Enable signature verification dan salin Webhook Secret
#
# STEP 3: Update environment variables di bawah ini
# ═══════════════════════════════════════════════════════════════════════════════

# API Key dari bayar.gg Dashboard -> Settings -> API Key
BAYARGG_API_KEY="ISI_API_KEY_ANDA"

# Webhook Secret untuk verifikasi signature
# Dari bayar.gg Dashboard -> Settings -> Webhooks
BAYARGG_WEBHOOK_SECRET="ISI_WEBHOOK_SECRET_ANDA"

# Callback URL untuk menerima webhook dari bayar.gg
# Untuk production: https://your-domain.com/api/webhooks/bayargg
BAYARGG_CALLBACK_URL="http://localhost:3001/api/webhooks/bayargg"

# ═══════════════════════════════════════════════════════════════════════════════
# PAYMENT METHODS YANG DIDUKUNG
# ═══════════════════════════════════════════════════════════════════════════════
# Virtual Account:
#   - bri_va      (BRI Virtual Account)
#   - livin_va    (Livin by Mandiri)
#
# QRIS:
#   - qris        (All QRIS enabled apps: GoPay, OVO, Dana, ShopeePay, dll)
#
# E-Wallet:
#   - ovo         (OVO)
# ═══════════════════════════════════════════════════════════════════════════════
